@page
@model IndexModel
@{
    ViewData["Titulo"] = "Instaladores";
}
<section class="cartao">
    <h1>Instaladores</h1>
    @if (Model.Itens.Count == 0)
    {
        <p class="ajuda">Nenhum instalador publicado no momento.</p>
    }
    else
    {
        <p class="ajuda">Versões publicadas no último deploy. Os programas instalados também se atualizam sozinhos (com aviso ao usuário).</p>
        <table class="lista">
            <thead>
                <tr><th>Programa</th><th>Versão</th><th class="num">Tamanho</th><th>Publicado em</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Itens)
                {
                    <tr>
                        <td data-titulo="Programa">
                            <div class="programa">
                                @if (i.Icone.Length > 0)
                                {
                                    <img class="icone" src="/icone/@Uri.EscapeDataString(System.IO.Path.GetFileName(i.Icone))" alt="" width="40" height="40" loading="lazy">
                                }
                                else
                                {
                                    <span class="icone vazio"></span>
                                }
                                <div><strong>@i.Programa</strong><div class="arquivo">@i.Arquivo</div></div>
                            </div>
                        </td>
                        <td data-titulo="Versão" class="mono">@i.Versao</td>
                        <td data-titulo="Tamanho" class="num">@IndexModel.Tamanho(i.Tamanho)</td>
                        <td data-titulo="Publicado em">@(i.Data == default ? "" : i.Data.ToString("dd/MM/yyyy HH:mm"))</td>
                        <td class="acao"><a class="botao" href="/baixar/@Uri.EscapeDataString(i.Arquivo)" title="SHA-256: @i.Sha256">Baixar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="cartao">
    <h2>Outros downloads</h2>
    <p class="ajuda">Programas de terceiros usados com os sistemas, baixados do site oficial de cada um.</p>
    <table class="lista">
        <tbody>
            <tr>
                <td data-titulo="Programa">
                    <div class="programa">
                        <span class="icone sigla" aria-hidden="true">PG</span>
                        <div><strong>PostgreSQL</strong><div class="arquivo">Banco de dados · instalador para Windows no site oficial (postgresql.org)</div></div>
                    </div>
                </td>
                <td class="acao"><a class="botao externo" href="https://www.postgresql.org/download/windows/" target="_blank" rel="noopener noreferrer">Abrir o site</a></td>
            </tr>
        </tbody>
    </table>
</section>
