<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@(ViewData["Titulo"] ?? "Downloads") · BrPDV</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topo">
        <div class="marca"><span class="logo">BrPDV</span> <span class="sub">Downloads</span></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/sair" class="sair">
                <span class="usuario">@User.Identity.Name</span>
                <button type="submit" class="botao-link">Sair</button>
            </form>
        }
    </header>
    <main class="conteudo">
        @RenderBody()
    </main>
    <footer class="rodape">BrPDV Comércio e Serviços · uso restrito às revendas</footer>
</body>
</html>
