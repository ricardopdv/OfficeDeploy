@page "/entrar"
@model EntrarModel
@{
    ViewData["Titulo"] = "Entrar";
}
<section class="cartao login">
    <h1>Entrar</h1>
    <p class="ajuda">Use o mesmo e-mail e senha do portal das revendas.</p>
    @if (!string.IsNullOrEmpty(Model.Erro))
    {
        <div class="erro" role="alert">@Model.Erro</div>
    }
    <form method="post">
        <label for="email">E-mail</label>
        <input id="email" name="Email" type="email" value="@Model.Email" autocomplete="username" required autofocus />
        <label for="senha">Senha</label>
        <input id="senha" name="Senha" type="password" autocomplete="current-password" required />
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="botao">Entrar</button>
    </form>
</section>
