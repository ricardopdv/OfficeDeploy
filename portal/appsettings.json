{
  "Urls": "http://127.0.0.1:8010",
  "Portal": {
    // login do portal das revendas (o mesmo usuario e senha): api/Accounts/Login da API do site (kestrel-site),
    // no mesmo servidor desde a virada das revendas (revendas\LEIA-ME.md)
    "ApiLogin": "http://127.0.0.1:8000/api/Accounts/Login",
    // papeis que podem baixar (os mesmos que acessam o portal das revendas: Program.AllRoles do RevendasRazor)
    "Papeis": [ "Admin", "Revenda" ],
    // pasta publicada pelo Enviar.ps1 (instaladores/ e instaladores.json)
    "Pasta": "/var/www/update",
    // true atras do nginx: o arquivo sai pelo nginx (X-Accel-Redirect para /_instaladores/); false entrega pelo proprio app
    "XAccel": true,
    // chaves do cookie de login (sobrevivem a reinicios do servico)
    "PastaChaves": "/var/lib/update-portal/chaves",
    "HorasSessao": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
